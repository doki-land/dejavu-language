{
    "irVersion": "v0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            {
                "type": "Stmt.For",
                "item": "x",
                "iterable": { "type": "Expr.Identifier", "name": "items" },
                "body": [
                    {
                        "type": "Interpolation",
                        "expression": { "type": "Expr.Identifier", "name": "x" },
                        "trim": "none"
                    },
                    { "type": "Stmt.Continue", "trim": "none" },
                    { "type": "Text", "value": "X" }
                ],
                "trim": "none"
            },
            { "type": "Text", "value": "!" }
        ]
    }
}
