{
    "irVersion": "v0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            {
                "type": "Stmt.For",
                "item": "x",
                "iterable": { "type": "Expr.Identifier", "name": "items" },
                "body": [
                    {
                        "type": "Stmt.If",
                        "test": {
                            "type": "Expr.Binary",
                            "operator": "==",
                            "left": { "type": "Expr.Identifier", "name": "x" },
                            "right": { "type": "Expr.Literal", "value": 2 }
                        },
                        "consequent": [
                            { "type": "Stmt.Break", "trim": "none" }
                        ],
                        "elseIfs": [],
                        "alternate": [],
                        "trim": "none"
                    },
                    {
                        "type": "Interpolation",
                        "expression": { "type": "Expr.Identifier", "name": "x" },
                        "trim": "none"
                    }
                ],
                "trim": "none"
            }
        ]
    }
}
