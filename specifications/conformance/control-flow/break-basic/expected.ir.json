{
    "irVersion": "v0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            {
                "type": "Stmt.For",
                "item": "x",
                "iterable": { "type": "Expr.Identifier", "name": "items" },
                "body": [
                    { "type": "Text", "value": "A" },
                    { "type": "Stmt.Break", "trim": "none" },
                    { "type": "Text", "value": "B" }
                ],
                "trim": "none"
            }
        ]
    }
}
