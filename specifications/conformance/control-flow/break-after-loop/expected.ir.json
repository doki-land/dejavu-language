{
    "irVersion": "v0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            {
                "type": "Stmt.For",
                "item": "x",
                "iterable": { "type": "Expr.Identifier", "name": "items" },
                "body": [
                    { "type": "Stmt.Break", "trim": "none" }
                ],
                "trim": "none"
            },
            { "type": "Text", "value": "after" }
        ]
    }
}
