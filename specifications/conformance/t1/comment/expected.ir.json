{
    "irVersion": "1.0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            {
                "type": "Text",
                "value": "Hi"
            },
            {
                "type": "Comment",
                "value": " ignore "
            },
            {
                "type": "Text",
                "value": "!"
            }
        ]
    }
}
