{
    "irVersion": "v0",
    "language": {
        "syntaxMode": "template",
        "template": {
            "codeStart": "<%",
            "codeEnd": "%>",
            "commentStart": "<#",
            "commentEnd": "#>",
            "supportFilterPipe": true,
            "legacyFor": false
        }
    },
    "body": {
        "type": "Template",
        "children": [
            { "type": "Text", "value": "x=" },
            {
                "type": "Interpolation",
                "trim": "none",
                "expression": {
                    "type": "Expr.Pipe",
                    "expression": { "type": "Expr.Identifier", "name": "value" },
                    "filter": "upper",
                    "arguments": []
                }
            }
        ]
    }
}
