{
  "name": "@dejavu/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Internal Dejavu CLI workspace package — end users install @doki-land/dejavu / the dejavu binary",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Doki Land",
  "homepage": "https://github.com/doki-land/dejavu-language/tree/dev/projects/dejavu.ts/dejavu-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doki-land/dejavu-language.git",
    "directory": "projects/dejavu.ts/dejavu-tools"
  },
  "bugs": {
    "url": "https://github.com/doki-land/dejavu-language/issues"
  },
  "main": "src/cli.ts",
  "bin": {
    "dejavu": "src/cli.ts"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dejavu/engine": "workspace:*",
    "cac": "^6.7.14"
  }
}
