  homeContractEyebrow: 'THE CONTRACT',
  homeContractTitle: 'Small surface. Verifiable semantics.',
  homeContractLede: 'The author surface is one <% %> slot, one |> filter set, and three composition keywords: extends, include, block. Strictness is enforced by the IR and by conformance suites shared across hosts.',
  homeContract1Title: 'Single-slot syntax',
  homeContract1Body: '<% %> carries both statements and expressions, split by keyword. There is no second output delimiter; comments use their own <# #> delimiters.',
  homeContract1Token: '<% if %>…<% end if %>',
  homeContract2Title: 'Shared IR',
  homeContract2Body: 'A versioned intermediate representation is the only contract between the parser and the hosts; every host verifies against the same conformance fixtures.',
  homeContract2Token: 'IR / v0',
  homeContract3Title: 'Deterministic rendering',
  homeContract3Body: 'The same IR plus the same context always produces the same output. Cross-host drift is surfaced by fixtures and treated as a defect.',
  homeContract3Token: 'render(IR, ctx)',
  homeContract4Title: 'Explicit strictness',
  homeContract4Body: 'strictUndefined covers all three kinds of missing access — identifiers, members, and indexes — with structured diagnostic codes and source spans.',
  homeContract4Token: 'strict: true',

