                            <text class="pipeline__card-mono" x="434" y="240">Hello, Mira.</text>
                            <text class="pipeline__card-mono pipeline__card-mono--dim" x="434" y="262">deterministic</text>
                            <text class="pipeline__card-mono pipeline__card-mono--dim" x="434" y="284">byte-identical</text>
                        </g>

                        <g class="pipeline__hosts">
