</template>

<script client>
import {
    homeEyebrow,
    homeTitleLead,
    homeTitleAccent,
    homeLede,
    homeActionPlayground,
    homeActionHosts,
    homeFact1Value,
    homeFact1Label,
    homeFact2Value,
    homeFact2Label,
    homeFact3Value,
    homeFact3Label,
    homeInstallHint,
    homeEdition,
    homeDiagramCaption,
    homeProofStatement,
    homeProofEquation,
    homeProofTag,
    homeContractEyebrow,
    homeContractTitle,
    homeContractLede,
    homeContract1Title,
    homeContract1Body,
    homeContract1Token,
    homeContract2Title,
    homeContract2Body,
    homeContract2Token,
    homeContract3Title,
    homeContract3Body,
    homeContract3Token,
    homeContract4Title,
    homeContract4Body,
    homeContract4Token,
    homeAnatomyEyebrow,
    homeAnatomyTitle,
    homeAnatomyLede,
    homeAnatomySourceLabel,
    homeAnatomySourceNote,
    homeAnatomyOutputLabel,
    homeAnatomyOutputNote,
    homeAnatomyFooter,
    homeHostsEyebrow,
    homeHostsTitle,
    homeHostsLede,
    homeHostsEquationLeft,
    homeHostsEquationMid,
    homeHostsEquationRight,
    homeCtaEyebrow,
    homeCtaTitle,
    homeCtaAction,
    titleHome,
} from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class Home {
    homeEyebrowLabel = "";
    homeTitleLeadLabel = "";
    homeTitleAccentLabel = "";
    homeLedeLabel = "";
    homeActionPlaygroundLabel = "";
    homeActionHostsLabel = "";
    homeFact1ValueLabel = "";
    homeFact1LabelLabel = "";
    homeFact2ValueLabel = "";
    homeFact2LabelLabel = "";
    homeFact3ValueLabel = "";
    homeFact3LabelLabel = "";
    homeInstallHintLabel = "";
    homeEditionLabel = "";
    homeDiagramCaptionLabel = "";
    homeProofStatementLabel = "";
    homeProofEquationLabel = "";
    homeProofTagLabel = "";
    homeContractEyebrowLabel = "";
    homeContractTitleLabel = "";
    homeContractLedeLabel = "";
    homeContract1TitleLabel = "";
    homeContract1BodyLabel = "";
    homeContract1TokenLabel = "";
    homeContract2TitleLabel = "";
    homeContract2BodyLabel = "";
    homeContract2TokenLabel = "";
    homeContract3TitleLabel = "";
    homeContract3BodyLabel = "";
    homeContract3TokenLabel = "";
    homeContract4TitleLabel = "";
    homeContract4BodyLabel = "";
    homeContract4TokenLabel = "";
    homeAnatomyEyebrowLabel = "";
    homeAnatomyTitleLabel = "";
    homeAnatomyLedeLabel = "";
    homeAnatomySourceLabelLabel = "";
    homeAnatomySourceNoteLabel = "";
    homeAnatomyOutputLabelLabel = "";
    homeAnatomyOutputNoteLabel = "";
    homeAnatomyFooterLabel = "";
    homeHostsEyebrowLabel = "";
    homeHostsTitleLabel = "";
    homeHostsLedeLabel = "";
    homeHostsEquationLeftLabel = "";
    homeHostsEquationMidLabel = "";
    homeHostsEquationRightLabel = "";
    homeCtaEyebrowLabel = "";
    homeCtaTitleLabel = "";
    homeCtaActionLabel = "";
    anatomySourceHtml = [
        '<span class="tok-kw">&lt;% if</span> <span class="tok-expr">user.adult</span> <span class="tok-kw">%&gt;</span>',
        '  &lt;h1&gt;<span class="tok-kw">&lt;%</span> <span class="tok-expr">user.name</span> <span class="tok-kw">%&gt;</span>&lt;/h1&gt;',
        '<span class="tok-kw">&lt;% else %&gt;</span>',
        '  &lt;p&gt;<span class="tok-kw">&lt;%</span> <span class="tok-str">"come back later"</span> <span class="tok-kw">%&gt;</span>&lt;/p&gt;',
        '<span class="tok-kw">&lt;% end if %&gt;</span>',
        '<span class="tok-kw">&lt;% loop</span> <span class="tok-expr">item in items</span> <span class="tok-kw">%&gt;</span>',
        '  &lt;li&gt;<span class="tok-kw">&lt;%</span> <span class="tok-expr">item</span> <span class="tok-op">|&gt;</span> <span class="tok-fn">escape</span> <span class="tok-kw">%&gt;</span>&lt;/li&gt;',
        '<span class="tok-kw">&lt;% end loop %&gt;</span>',
    ].join("\n");
    anatomyOutputHtml = [
        '&lt;h1&gt;Hello, Mira.&lt;/h1&gt;',
        '&lt;li&gt;Notebook&lt;/li&gt;',
        '&lt;li&gt;Compass&lt;/li&gt;',
        '&lt;li&gt;Lantern&lt;/li&gt;',
    ].join("\n");
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    refreshCopy() {
        this.homeEyebrowLabel = homeEyebrow();
        this.homeTitleLeadLabel = homeTitleLead();
        this.homeTitleAccentLabel = homeTitleAccent();
        this.homeLedeLabel = homeLede();
        this.homeActionPlaygroundLabel = homeActionPlayground();
        this.homeActionHostsLabel = homeActionHosts();
        this.homeFact1ValueLabel = homeFact1Value();
        this.homeFact1LabelLabel = homeFact1Label();
        this.homeFact2ValueLabel = homeFact2Value();
        this.homeFact2LabelLabel = homeFact2Label();
        this.homeFact3ValueLabel = homeFact3Value();
        this.homeFact3LabelLabel = homeFact3Label();
        this.homeInstallHintLabel = homeInstallHint();
        this.homeEditionLabel = homeEdition();
        this.homeDiagramCaptionLabel = homeDiagramCaption();
        this.homeProofStatementLabel = homeProofStatement();
        this.homeProofEquationLabel = homeProofEquation();
        this.homeProofTagLabel = homeProofTag();
        this.homeContractEyebrowLabel = homeContractEyebrow();
        this.homeContractTitleLabel = homeContractTitle();
        this.homeContractLedeLabel = homeContractLede();
        this.homeContract1TitleLabel = homeContract1Title();
        this.homeContract1BodyLabel = homeContract1Body();
        this.homeContract1TokenLabel = homeContract1Token();
        this.homeContract2TitleLabel = homeContract2Title();
        this.homeContract2BodyLabel = homeContract2Body();
        this.homeContract2TokenLabel = homeContract2Token();
        this.homeContract3TitleLabel = homeContract3Title();
        this.homeContract3BodyLabel = homeContract3Body();
        this.homeContract3TokenLabel = homeContract3Token();
        this.homeContract4TitleLabel = homeContract4Title();
        this.homeContract4BodyLabel = homeContract4Body();
        this.homeContract4TokenLabel = homeContract4Token();
        this.homeAnatomyEyebrowLabel = homeAnatomyEyebrow();
        this.homeAnatomyTitleLabel = homeAnatomyTitle();
        this.homeAnatomyLedeLabel = homeAnatomyLede();
        this.homeAnatomySourceLabelLabel = homeAnatomySourceLabel();
        this.homeAnatomySourceNoteLabel = homeAnatomySourceNote();
        this.homeAnatomyOutputLabelLabel = homeAnatomyOutputLabel();
        this.homeAnatomyOutputNoteLabel = homeAnatomyOutputNote();
        this.homeAnatomyFooterLabel = homeAnatomyFooter();
        this.homeHostsEyebrowLabel = homeHostsEyebrow();
        this.homeHostsTitleLabel = homeHostsTitle();
        this.homeHostsLedeLabel = homeHostsLede();
        this.homeHostsEquationLeftLabel = homeHostsEquationLeft();
        this.homeHostsEquationMidLabel = homeHostsEquationMid();
        this.homeHostsEquationRightLabel = homeHostsEquationRight();
        this.homeCtaEyebrowLabel = homeCtaEyebrow();
        this.homeCtaTitleLabel = homeCtaTitle();
        this.homeCtaActionLabel = homeCtaAction();
        if (typeof document !== "undefined") document.title = titleHome();
    }
}
</script>
