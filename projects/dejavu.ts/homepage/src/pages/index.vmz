                        <path class="pipeline__wire" d="M354 249 C 384 249 388 249 416 249" />
                        <circle class="pipeline__pulse pipeline__pulse--a" r="3.5" cx="0" cy="0">
                            <animateMotion dur="2.4s" repeatCount="indefinite" path="M228 249 C 258 249 262 249 290 249" />
                        </circle>
                        <circle class="pipeline__pulse pipeline__pulse--b" r="3.5" cx="0" cy="0">
                            <animateMotion dur="2.4s" begin="1.2s" repeatCount="indefinite" path="M354 249 C 384 249 388 249 416 249" />
                        </circle>

                        <g class="pipeline__card pipeline__card--source">
                            <rect x="48" y="190" width="180" height="118" rx="4" />
                            <text class="pipeline__card-label" x="66" y="216">greeting.dejavu</text>
                            <text class="pipeline__card-mono" x="66" y="240">&lt;% name %&gt;</text>
                            <text class="pipeline__card-mono pipeline__card-mono--dim" x="66" y="262">&lt;% if %&gt; … &lt;% end if %&gt;</text>
                            <text class="pipeline__card-mono pipeline__card-mono--dim" x="66" y="284">&lt;% loop %&gt; … &lt;% end loop %&gt;</text>
                        </g>

                        <g class="pipeline__core">
                            <circle class="pipeline__core-orbit" cx="322" cy="249" r="52" />
