<template>
    <div class="landing">
        <section class="hero">
            <div class="wrap hero__grid">
                <div class="hero__copy">
                    <p class="overline"><span class="overline__rule"></span>{{ homeEyebrowLabel }}</p>
                    <h1 class="hero__title">{{ homeTitleLeadLabel }}<br /><em>{{ homeTitleAccentLabel }}</em></h1>
                    <p class="hero__lede">{{ homeLedeLabel }}</p>
                    <div class="hero__actions">
                        <a class="action action--primary" href="/playground">{{ homeActionPlaygroundLabel }}<span aria-hidden="true">→</span></a>
                        <a class="action action--ghost" href="/ecosystem">{{ homeActionHostsLabel }}</a>
                    </div>
                    <dl class="hero__facts">
                        <div><dt>{{ homeFact1ValueLabel }}</dt><dd>{{ homeFact1LabelLabel }}</dd></div>
                        <div><dt>{{ homeFact2ValueLabel }}</dt><dd>{{ homeFact2LabelLabel }}</dd></div>
                        <div><dt>{{ homeFact3ValueLabel }}</dt><dd>{{ homeFact3LabelLabel }}</dd></div>
                    </dl>
                </div>

                <figure class="hero__figure">
                    <div class="specimen">
                        <div class="specimen__bar">
                            <code>{{ homeSpecimenSourceLabelLabel }}</code>
                            <small>{{ homeSpecimenSourceNoteLabel }}</small>
                        </div>
                        <pre class="specimen__code"><code v-html="specimenSourceHtml"></code></pre>
                        <div class="specimen__seam">
                            <span aria-hidden="true">↓</span>
                            <code>{{ homeSpecimenEquationLabel }}</code>
                        </div>
                        <div class="specimen__bar specimen__bar--out">
                            <code>{{ homeSpecimenOutputLabelLabel }}</code>
                            <small>{{ homeSpecimenOutputNoteLabel }}</small>
                        </div>
                        <pre class="specimen__code specimen__code--out"><code v-html="specimenOutputHtml"></code></pre>
                    </div>
                    <figcaption class="hero__figure-caption"><span>{{ homeDiagramCaptionLabel }}</span><span aria-hidden="true">FIG. 01</span></figcaption>
                </figure>
            </div>
            <div class="wrap hero__baseline">
                <div class="hero__install"><span class="hero__install-glyph" aria-hidden="true">$</span><code>npm install @doki-land/dejavu</code><span class="hero__install-hint">{{ homeInstallHintLabel }}</span></div>
                <span class="hero__edition">{{ homeEditionLabel }}</span>
            </div>
        </section>

        <section class="conformance">
            <div class="wrap">
                <div class="conformance__head">
                    <p class="overline overline--light"><span class="overline__rule"></span>{{ homeConformanceEyebrowLabel }}</p>
                    <h2>{{ homeConformanceTitleLabel }}</h2>
                    <p class="conformance__lede">{{ homeConformanceLedeLabel }}</p>
                </div>
                <div class="conformance__rail" role="table" aria-label="Five hosts produce the same output bytes">
                    <div class="conformance__meta" role="row">
                        <span>{{ homeConformanceFixtureLabel }}</span>
                        <span>{{ homeConformanceExpectedLabel }}</span>
                    </div>
                    <div class="conformance__row" role="row">
                        <span class="conformance__host">ts</span>
                        <span class="conformance__pkg">@doki-land/dejavu</span>
                        <code class="conformance__bytes">&lt;h1&gt;Hello, Mira.&lt;/h1&gt;</code>
                        <span class="conformance__diff"><i aria-hidden="true"></i>0</span>
                    </div>
                    <div class="conformance__row" role="row">
                        <span class="conformance__host">rs</span>
                        <span class="conformance__pkg">dejavu · crates.io</span>
                        <code class="conformance__bytes">&lt;h1&gt;Hello, Mira.&lt;/h1&gt;</code>
                        <span class="conformance__diff"><i aria-hidden="true"></i>0</span>
                    </div>
                    <div class="conformance__row" role="row">
                        <span class="conformance__host">py</span>
                        <span class="conformance__pkg">dejavu · PyPI</span>
                        <code class="conformance__bytes">&lt;h1&gt;Hello, Mira.&lt;/h1&gt;</code>
                        <span class="conformance__diff"><i aria-hidden="true"></i>0</span>
                    </div>
                    <div class="conformance__row" role="row">
                        <span class="conformance__host">net</span>
                        <span class="conformance__pkg">Dejavu · NuGet</span>
                        <code class="conformance__bytes">&lt;h1&gt;Hello, Mira.&lt;/h1&gt;</code>
                        <span class="conformance__diff"><i aria-hidden="true"></i>0</span>
                    </div>
                    <div class="conformance__row" role="row">
                        <span class="conformance__host">kt</span>
                        <span class="conformance__pkg">dejavu · JVM</span>
                        <code class="conformance__bytes">&lt;h1&gt;Hello, Mira.&lt;/h1&gt;</code>
                        <span class="conformance__diff"><i aria-hidden="true"></i>0</span>
                    </div>
                </div>
                <div class="conformance__foot">
                    <code>render_host(IR, ctx) == expected.out.txt</code>
                    <span class="conformance__tally"><i aria-hidden="true"></i>{{ homeConformanceTallyLabel }}</span>
                </div>
            </div>
        </section>

        <section class="contract wrap">
            <div class="contract__heading">
                <p class="overline"><span class="overline__rule"></span>{{ homeContractEyebrowLabel }}</p>
                <h2>{{ homeContractTitleLabel }}</h2>
                <p class="section-lede">{{ homeContractLedeLabel }}</p>
            </div>
            <div class="contract__list">
                <article class="contract__row">
                    <span class="contract__index">01</span>
                    <h3>{{ homeContract1TitleLabel }}</h3>
                    <p>{{ homeContract1BodyLabel }}</p>
                    <code class="contract__token">{{ homeContract1TokenLabel }}</code>
                </article>
                <article class="contract__row">
                    <span class="contract__index">02</span>
                    <h3>{{ homeContract2TitleLabel }}</h3>
                    <p>{{ homeContract2BodyLabel }}</p>
                    <code class="contract__token">{{ homeContract2TokenLabel }}</code>
                </article>
                <article class="contract__row">
                    <span class="contract__index">03</span>
                    <h3>{{ homeContract3TitleLabel }}</h3>
                    <p>{{ homeContract3BodyLabel }}</p>
                    <code class="contract__token">{{ homeContract3TokenLabel }}</code>
                </article>
                <article class="contract__row">
                    <span class="contract__index">04</span>
                    <h3>{{ homeContract4TitleLabel }}</h3>
                    <p>{{ homeContract4BodyLabel }}</p>
                    <code class="contract__token">{{ homeContract4TokenLabel }}</code>
                </article>
            </div>
        </section>

        <section class="hosts wrap">
            <div class="hosts__heading">
                <div>
                    <p class="overline"><span class="overline__rule"></span>{{ homeHostsEyebrowLabel }}</p>
                    <h2>{{ homeHostsTitleLabel }}</h2>
                </div>
                <p class="section-lede">{{ homeHostsLedeLabel }}</p>
            </div>
            <div class="hosts__rail">
                <a class="hosts__chip" href="/ecosystem"><span class="hosts__glyph">TS</span><span>TypeScript</span><span class="hosts__arrow" aria-hidden="true">↗</span></a>
                <a class="hosts__chip" href="/ecosystem"><span class="hosts__glyph">Rs</span><span>Rust</span><span class="hosts__arrow" aria-hidden="true">↗</span></a>
                <a class="hosts__chip" href="/ecosystem"><span class="hosts__glyph">Py</span><span>Python</span><span class="hosts__arrow" aria-hidden="true">↗</span></a>
                <a class="hosts__chip" href="/ecosystem"><span class="hosts__glyph">.N</span><span>C# / .NET</span><span class="hosts__arrow" aria-hidden="true">↗</span></a>
                <a class="hosts__chip" href="/ecosystem"><span class="hosts__glyph">Kt</span><span>Kotlin</span><span class="hosts__arrow" aria-hidden="true">↗</span></a>
            </div>
            <div class="hosts__equation"><span>{{ homeHostsEquationLeftLabel }}</span><b>→</b><span>{{ homeHostsEquationMidLabel }}</span><b>→</b><span>{{ homeHostsEquationRightLabel }}</span></div>
        </section>

        <section class="cta wrap">
            <div>
                <p class="overline"><span class="overline__rule"></span>{{ homeCtaEyebrowLabel }}</p>
                <h2>{{ homeCtaTitleLabel }}</h2>
            </div>
            <a class="action action--primary" href="/playground">{{ homeCtaActionLabel }}<span aria-hidden="true">→</span></a>
        </section>
    </div>
</template>

<script client>
import {
    homeEyebrow,
    homeTitleLead,
    homeTitleAccent,
    homeLede,
    homeActionPlayground,
    homeActionHosts,
    homeFact1Value,
    homeFact1Label,
    homeFact2Value,
    homeFact2Label,
    homeFact3Value,
    homeFact3Label,
    homeInstallHint,
    homeEdition,
    homeDiagramCaption,
    homeSpecimenSourceLabel,
    homeSpecimenSourceNote,
    homeSpecimenOutputLabel,
    homeSpecimenOutputNote,
    homeSpecimenEquation,
    homeConformanceEyebrow,
    homeConformanceTitle,
    homeConformanceLede,
    homeConformanceFixture,
    homeConformanceExpected,
    homeConformanceTally,
    homeContractEyebrow,
    homeContractTitle,
    homeContractLede,
    homeContract1Title,
    homeContract1Body,
    homeContract1Token,
    homeContract2Title,
    homeContract2Body,
    homeContract2Token,
    homeContract3Title,
    homeContract3Body,
    homeContract3Token,
    homeContract4Title,
    homeContract4Body,
    homeContract4Token,
    homeHostsEyebrow,
    homeHostsTitle,
    homeHostsLede,
    homeHostsEquationLeft,
    homeHostsEquationMid,
    homeHostsEquationRight,
    homeCtaEyebrow,
    homeCtaTitle,
    homeCtaAction,
    titleHome,
} from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class Home {
    homeEyebrowLabel = "";
    homeTitleLeadLabel = "";
    homeTitleAccentLabel = "";
    homeLedeLabel = "";
    homeActionPlaygroundLabel = "";
    homeActionHostsLabel = "";
    homeFact1ValueLabel = "";
    homeFact1LabelLabel = "";
    homeFact2ValueLabel = "";
    homeFact2LabelLabel = "";
    homeFact3ValueLabel = "";
    homeFact3LabelLabel = "";
    homeInstallHintLabel = "";
    homeEditionLabel = "";
    homeDiagramCaptionLabel = "";
    homeSpecimenSourceLabelLabel = "";
    homeSpecimenSourceNoteLabel = "";
    homeSpecimenOutputLabelLabel = "";
    homeSpecimenOutputNoteLabel = "";
    homeSpecimenEquationLabel = "";
    homeConformanceEyebrowLabel = "";
    homeConformanceTitleLabel = "";
    homeConformanceLedeLabel = "";
    homeConformanceFixtureLabel = "";
    homeConformanceExpectedLabel = "";
    homeConformanceTallyLabel = "";
    homeContractEyebrowLabel = "";
    homeContractTitleLabel = "";
    homeContractLedeLabel = "";
    homeContract1TitleLabel = "";
    homeContract1BodyLabel = "";
    homeContract1TokenLabel = "";
    homeContract2TitleLabel = "";
    homeContract2BodyLabel = "";
    homeContract2TokenLabel = "";
    homeContract3TitleLabel = "";
    homeContract3BodyLabel = "";
    homeContract3TokenLabel = "";
    homeContract4TitleLabel = "";
    homeContract4BodyLabel = "";
    homeContract4TokenLabel = "";
    homeHostsEyebrowLabel = "";
    homeHostsTitleLabel = "";
    homeHostsLedeLabel = "";
    homeHostsEquationLeftLabel = "";
    homeHostsEquationMidLabel = "";
    homeHostsEquationRightLabel = "";
    homeCtaEyebrowLabel = "";
    homeCtaTitleLabel = "";
    homeCtaActionLabel = "";
    specimenSourceHtml = [
        '<span class="tok-kw">&lt;% if</span> <span class="tok-expr">user.adult</span> <span class="tok-kw">%&gt;</span>',
        '  &lt;h1&gt;<span class="tok-kw">&lt;%</span> <span class="tok-expr">user.name</span> <span class="tok-kw">%&gt;</span>&lt;/h1&gt;',
        '<span class="tok-kw">&lt;% else %&gt;</span>',
        '  &lt;p&gt;<span class="tok-kw">&lt;%</span> <span class="tok-str">"come back later"</span> <span class="tok-kw">%&gt;</span>&lt;/p&gt;',
        '<span class="tok-kw">&lt;% end if %&gt;</span>',
        '<span class="tok-kw">&lt;% loop</span> <span class="tok-expr">item in items</span> <span class="tok-kw">%&gt;</span>',
        '  &lt;li&gt;<span class="tok-kw">&lt;%</span> <span class="tok-expr">item</span> <span class="tok-op">|&gt;</span> <span class="tok-fn">escape</span> <span class="tok-kw">%&gt;</span>&lt;/li&gt;',
        '<span class="tok-kw">&lt;% end loop %&gt;</span>',
    ].join("\n");
    specimenOutputHtml = [
        '&lt;h1&gt;Hello, Mira.&lt;/h1&gt;',
        '&lt;li&gt;Notebook&lt;/li&gt;',
        '&lt;li&gt;Compass&lt;/li&gt;',
        '&lt;li&gt;Lantern&lt;/li&gt;',
    ].join("\n");
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }

    refreshCopy() {
        this.homeEyebrowLabel = homeEyebrow();
        this.homeTitleLeadLabel = homeTitleLead();
        this.homeTitleAccentLabel = homeTitleAccent();
        this.homeLedeLabel = homeLede();
        this.homeActionPlaygroundLabel = homeActionPlayground();
        this.homeActionHostsLabel = homeActionHosts();
        this.homeFact1ValueLabel = homeFact1Value();
        this.homeFact1LabelLabel = homeFact1Label();
        this.homeFact2ValueLabel = homeFact2Value();
        this.homeFact2LabelLabel = homeFact2Label();
        this.homeFact3ValueLabel = homeFact3Value();
        this.homeFact3LabelLabel = homeFact3Label();
        this.homeInstallHintLabel = homeInstallHint();
        this.homeEditionLabel = homeEdition();
        this.homeDiagramCaptionLabel = homeDiagramCaption();
        this.homeSpecimenSourceLabelLabel = homeSpecimenSourceLabel();
        this.homeSpecimenSourceNoteLabel = homeSpecimenSourceNote();
        this.homeSpecimenOutputLabelLabel = homeSpecimenOutputLabel();
        this.homeSpecimenOutputNoteLabel = homeSpecimenOutputNote();
        this.homeSpecimenEquationLabel = homeSpecimenEquation();
        this.homeConformanceEyebrowLabel = homeConformanceEyebrow();
        this.homeConformanceTitleLabel = homeConformanceTitle();
        this.homeConformanceLedeLabel = homeConformanceLede();
        this.homeConformanceFixtureLabel = homeConformanceFixture();
        this.homeConformanceExpectedLabel = homeConformanceExpected();
        this.homeConformanceTallyLabel = homeConformanceTally();
        this.homeContractEyebrowLabel = homeContractEyebrow();
        this.homeContractTitleLabel = homeContractTitle();
        this.homeContractLedeLabel = homeContractLede();
        this.homeContract1TitleLabel = homeContract1Title();
        this.homeContract1BodyLabel = homeContract1Body();
        this.homeContract1TokenLabel = homeContract1Token();
        this.homeContract2TitleLabel = homeContract2Title();
        this.homeContract2BodyLabel = homeContract2Body();
        this.homeContract2TokenLabel = homeContract2Token();
        this.homeContract3TitleLabel = homeContract3Title();
        this.homeContract3BodyLabel = homeContract3Body();
        this.homeContract3TokenLabel = homeContract3Token();
        this.homeContract4TitleLabel = homeContract4Title();
        this.homeContract4BodyLabel = homeContract4Body();
        this.homeContract4TokenLabel = homeContract4Token();
        this.homeHostsEyebrowLabel = homeHostsEyebrow();
        this.homeHostsTitleLabel = homeHostsTitle();
        this.homeHostsLedeLabel = homeHostsLede();
        this.homeHostsEquationLeftLabel = homeHostsEquationLeft();
        this.homeHostsEquationMidLabel = homeHostsEquationMid();
        this.homeHostsEquationRightLabel = homeHostsEquationRight();
        this.homeCtaEyebrowLabel = homeCtaEyebrow();
        this.homeCtaTitleLabel = homeCtaTitle();
        this.homeCtaActionLabel = homeCtaAction();
        if (typeof document !== "undefined") document.title = titleHome();
    }
}
</script>
