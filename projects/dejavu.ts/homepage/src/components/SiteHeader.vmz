<template>
    <header data-vmz-fixture="site-header" class="site-header">
        <div class="site-header__inner">
            <a class="site-brand" href="/" :aria-label="homeAriaLabel">
                <span class="site-brand__symbol" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none"><rect x="9" y="9" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><rect x="5" y="5" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.8" opacity="0.45"/></svg></span><span class="site-brand__word">{{ brandShortLabel }}</span>
                <span class="site-brand__tag">{{ brandFullLabel }}</span>
            </a>

            <nav class="site-nav" :aria-label="navPrimaryLabel" :data-open="menuOpen ? 'true' : null" @click="(() => closeMenu())">
                <a href="/" :aria-current="homeCurrent">{{ navHomeLabel }}</a>
                <a href="/playground" :aria-current="playgroundCurrent">{{ navPlaygroundLabel }}</a>
                <a href="/ecosystem" :aria-current="ecosystemCurrent">{{ navEcosystemLabel }}</a>
                <a href="/d/" :aria-current="docsCurrent">{{ navDocsLabel }}</a>
            </nav>

            <div class="site-header__tools">
                <button
                    type="button"
                    class="site-menu-toggle"
                    :aria-label="navPrimaryLabel"
                    :aria-expanded="menuOpen ? 'true' : 'false'"
                    @click="(() => toggleMenu())"
                >
                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </button>
                <details class="site-language">
                    <summary :aria-label="selectLanguageLabel">{{ langSummary }}</summary>
                    <div class="site-language__menu">
                        <button
                            type="button"
                            data-vmz-fixture="locale-zh-hans"
                            :aria-current="localeId === 'zh-hans' ? 'true' : null"
                            @click='(() => switchLocale("zh-hans"))'
                        >
                            {{ langZhFullLabel }}
                        </button>
                        <button
                            type="button"
                            data-vmz-fixture="locale-en"
                            :aria-current="localeId === 'en' ? 'true' : null"
                            @click='(() => switchLocale("en"))'
                        >
                            {{ langEnFullLabel }}
                        </button>
                    </div>
                </details>
                <a
                    :href="githubHref"
                    :aria-label="githubLabel"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="site-header__icon"
                >
                    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                        <path
                            fill="currentColor"
                            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                        />
                    </svg>
                </a>
            </div>
        </div>
    </header>
</template>

<script client>
import {
    brandShort,
    brandFull,
    navHome,
    navPlayground,
    navEcosystem,
    navDocs,
    navPrimary,
    github,
    selectLanguage,
    langZhFull,
    langEnFull,
    langZhShort,
    langEnShort,
} from "#locales/common";
import { isActivePath, readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

const GITHUB_HREF = "https://github.com/doki-land/dejavu-language";

export default class SiteHeader {
    brandShortLabel = "";
    brandFullLabel = "";
    navHomeLabel = "";
    navPlaygroundLabel = "";
    navEcosystemLabel = "";
    navDocsLabel = "";
    navPrimaryLabel = "";
    homeAriaLabel = "";
    githubLabel = "";
    selectLanguageLabel = "";
    langSummary = "";
    langZhFullLabel = "";
    langEnFullLabel = "";
    githubHref = GITHUB_HREF;
    localeId = "zh-hans";
    menuOpen = false;
    homeCurrent = null;
    playgroundCurrent = null;
    ecosystemCurrent = null;
    docsCurrent = null;
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
        this.syncNavState();
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") {
            this._unwatchLocale();
        }
        this._unwatchLocale = null;
    }

    toggleMenu() {
        this.menuOpen = !this.menuOpen;
    }

    closeMenu() {
        if (this.menuOpen) this.menuOpen = false;
    }

    syncNavState() {
        this.homeCurrent = isActivePath("/") ? "page" : null;
        this.playgroundCurrent = isActivePath("/playground") ? "page" : null;
        this.ecosystemCurrent = isActivePath("/ecosystem") ? "page" : null;
        this.docsCurrent = isActivePath("/d") ? "page" : null;
    }

    refreshCopy() {
        this.brandShortLabel = brandShort();
        this.brandFullLabel = brandFull();
        this.navHomeLabel = navHome();
        this.navPlaygroundLabel = navPlayground();
        this.navEcosystemLabel = navEcosystem();
        this.navDocsLabel = navDocs();
        this.navPrimaryLabel = navPrimary();
        this.homeAriaLabel = `${this.brandShortLabel} home`;
        this.githubLabel = github();
        this.selectLanguageLabel = selectLanguage();
        this.langZhFullLabel = langZhFull();
        this.langEnFullLabel = langEnFull();
        this.langSummary = this.localeId === "en" ? langEnShort() : langZhShort();
        this.syncNavState();
    }

    applyLocaleCopy(preferred) {
        this.localeId = readLocaleId(preferred);
        withLocaleHint(this.localeId, () => this.refreshCopy());
    }

    async switchLocale(to) {
        if (typeof window === "undefined") return;
        const fn = window.__vmzTransitionLocale;
        if (typeof fn !== "function") return;
        const r = await fn(to);
        if (r && r.status === "committed") {
            this.applyLocaleCopy(to);
        }
    }
}
</script>
