{
    "name": "@doki-land/dejavu-homepage",
    "version": "0.1.0",
    "private": true,
    "description": "Dejavu product homepage and playground, built on the VMZ stack",
    "license": "MPL-2.0",
    "type": "module",
    "scripts": {
        "check": "vmz check .",
        "dev": "node scripts/sync-wasm.mjs && vmz dev .",
        "build": "node scripts/sync-wasm.mjs && vmz check . && vmz build . --release --profile static",
        "preview": "vmz serve . --profile static"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/dejavu-language.git",
        "directory": "projects/dejavu.ts/homepage"
    },
    "homepage": "https://github.com/doki-land/dejavu-language/tree/dev/projects/dejavu.ts/homepage#readme",
    "bugs": {
        "url": "https://github.com/doki-land/dejavu-language/issues"
    },
    "dependencies": {
        "@doki-land/dejavu-unknown-wasm32": "0.0.17",
        "@vmz/core": "0.3.12",
        "@vmz/plugin": "0.3.12",
        "@vmz/ui": "0.3.12",
        "@vmz/ui-icons": "0.3.12"
    },
    "devDependencies": {
        "@vmz/vmz": "0.3.12",
        "typescript": "^5.9.2"
    }
}
