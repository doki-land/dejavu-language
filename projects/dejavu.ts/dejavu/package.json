{
    "name": "dejavu",
    "version": "0.0.1",
    "description": "Dejavu template engine — public TypeScript/JavaScript API",
    "type": "module",
    "main": "src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@dejavu/engine": "workspace:*"
    }
}
