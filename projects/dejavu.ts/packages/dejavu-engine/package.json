{
  "name": "@doki-land/dejavu-engine",
  "version": "0.0.13",
  "description": "Dejavu pure TypeScript AOT runtime — generated template modules depend on this package",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Doki Land",
  "homepage": "https://github.com/doki-land/dejavu-language/tree/dev/projects/packages/dejavu-engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doki-land/dejavu-language.git",
    "directory": "projects/packages/dejavu-engine"
  },
  "bugs": {
    "url": "https://github.com/doki-land/dejavu-language/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
