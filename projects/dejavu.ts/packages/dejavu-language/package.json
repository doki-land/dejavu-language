{
    "name": "@doki-land/dejavu-language",
    "version": "0.0.13",
    "description": "Dejavu WASM language bridge for browsers and Workers — host wrapper over @doki-land/dejavu-unknown-wasm32",
    "license": "MPL-2.0",
    "author": "Doki Land",
    "type": "module",
    "homepage": "https://github.com/doki-land/dejavu-language/tree/dev/projects/dejavu.ts/packages/dejavu-language",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/dejavu-language.git",
        "directory": "projects/dejavu.ts/packages/dejavu-language"
    },
    "bugs": {
        "url": "https://github.com/doki-land/dejavu-language/issues"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
