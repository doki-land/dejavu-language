{
    "name": "@dejavu/language",
    "version": "0.0.0",
    "private": true,
    "description": "Internal Dejavu language frontend — applications must depend on @doki-land/dejavu only",
    "type": "module",
    "license": "MPL-2.0",
    "author": "Doki Land",
    "homepage": "https://github.com/doki-land/dejavu-language/tree/dev/projects/dejavu.ts/dejavu-language",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/doki-land/dejavu-language.git",
        "directory": "projects/dejavu.ts/dejavu-language"
    },
    "bugs": {
        "url": "https://github.com/doki-land/dejavu-language/issues"
    },
    "main": "src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@dejavu/types": "workspace:*"
    }
}
