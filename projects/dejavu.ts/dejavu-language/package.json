{
    "name": "@dejavu/language",
    "version": "0.0.1",
    "private": true,
    "description": "Internal Dejavu language — apps must depend on the `dejavu` package only",
    "type": "module",
    "main": "src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --dts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@dejavu/types": "workspace:*"
    }
}
