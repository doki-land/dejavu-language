{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "paths": {
            "@dejavu/engine": ["../dejavu-engine/src/index.ts"],
            "@dejavu/types": ["../dejavu-types/src/index.ts"],
            "@dejavu/language": ["../dejavu-language/src/index.ts"]
        }
    },
    "include": ["src/**/*.ts"]
}
