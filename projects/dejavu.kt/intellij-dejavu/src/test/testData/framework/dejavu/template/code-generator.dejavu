<% block header %>
    <% if title %>
        # <% title %>,
    <% end if %>

<% end block %>

<% block content %>
    <% loop items in item %>
        - <% item.name %>: <% item.value %>
    <% end loop %>
<% end block %>

<% block footer %>
    Generated by Dejavu template engine.
<% end block %>