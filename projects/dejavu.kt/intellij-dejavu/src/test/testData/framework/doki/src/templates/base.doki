{% extends "base.doki" %}

{% block head %}
    <title>{% if title %}{% title %} - My Blog{% else %}My Blog{% end if %}</title>
    <link rel="stylesheet" href="/static/style.css">
{% end block %}

{% block header %}
    <header>
        <h1>My Blog</h1>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
            </ul>
        </nav>
    </header>
{% end block %}

{% block content %}
{% end block %}

{% block footer %}
    <footer>
        <p>&copy; {% year %} My Blog</p>
    </footer>
{% end block %}