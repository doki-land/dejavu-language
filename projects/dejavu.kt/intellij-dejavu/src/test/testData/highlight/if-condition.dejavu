<EXTENSION>{%</EXTENSION> <KEYWORD>if</KEYWORD> <IDENTIFIER>true</IDENTIFIER> <EXTENSION>%}</EXTENSION>
    <TEXT>true branch</TEXT>
<EXTENSION>{%</EXTENSION> <KEYWORD>else</KEYWORD> <EXTENSION>%}</EXTENSION>
    <TEXT>false branch</TEXT>
<EXTENSION>{%</EXTENSION> <KEYWORD>end</KEYWORD> <EXTENSION>%}</EXTENSION>


<EXTENSION>{%</EXTENSION> <KEYWORD>if</KEYWORD> <IDENTIFIER>add</IDENTIFIER><PARENTHESES>(</PARENTHESES><INTEGER>0</INTEGER> <OPERATOR>+</OPERATOR> <STRING>"1"</STRING><PARENTHESES>)</PARENTHESES> <EXTENSION>%}</EXTENSION>
    <TEXT>0 branch</TEXT>
<EXTENSION>{%</EXTENSION> <KEYWORD>else-if</KEYWORD> <INTEGER>1</INTEGER> <EXTENSION>%}</EXTENSION>
    <TEXT>1 branch</TEXT>
<EXTENSION>{%</EXTENSION> <KEYWORD>else</KEYWORD> <EXTENSION>%}</EXTENSION>
    <TEXT>other branch</TEXT>
<EXTENSION>{%</EXTENSION> <KEYWORD>end</KEYWORD> <EXTENSION>%}</EXTENSION>